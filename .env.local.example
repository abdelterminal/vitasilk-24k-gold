# Copy to .env.local and fill in.
#
# Google Apps Script web app /exec URL — see apps-script/Code.gs for setup.
# Server-side only: do NOT rename this to NEXT_PUBLIC_*, or the write endpoint
# ends up in the client bundle where anyone can post to your sheet.
#
# Leave unset in local dev and orders fall back to data/orders.jsonl.
SHEETS_ENDPOINT=
