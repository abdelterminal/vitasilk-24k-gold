# Keep the build context small and the image free of anything secret or local.
# Everything here is either rebuilt inside the container, platform-specific, or
# must never be baked into a layer.

# Rebuilt in the container. Copying the host's would also drop Windows-built
# native binaries (sharp) into a Linux image.
node_modules
.next

# Local build/tooling state
*.tsbuildinfo
next-env.d.ts
.vercel

# Secrets and customer data. .env* must never reach a layer — SHEETS_ENDPOINT
# is a live write handle to the order sheet, and it is injected at runtime
# instead. data/ holds real submitted orders.
.env
.env.*
data

# Not needed to build or run: offline image-processing tooling and docs
scripts
*.md

# Version control and CI
.git
.gitignore
.github

# Docker's own files — changing them should not invalidate the build context
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml

# Editor/OS noise
.DS_Store
.idea
.vscode
npm-debug.log*
